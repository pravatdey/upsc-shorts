# ---- LLM (script writing) ----
# Groq is the primary script writer. Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Gemini does two jobs: realistic Hindi TTS voice, AND fallback script writer
# if Groq is rate-limited. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- YouTube ----
# Only needed in CI. Locally the pipeline reads config/youtube_token.json.
# Generate that file once by running:  python authorize_youtube.py
# YOUTUBE_TOKEN_JSON=
